+// modelContextWindow returns the context window (in tokens) documented for a
+// model so window-aware clients stop seeing the previous hard-coded 128K.
+// Unknown models keep the historical fallback.
+func modelContextWindow(ids ...string) int {
+	const fallback = 128000
+	windows := map[string]int{
+		"kmodel":                256000,
+		"kimi":                  256000,
+		"kimi-k2":               256000,
+		"kimi-k2.6":             256000,
+		"kimi-k2-6":             256000,
+		"mmodel":                204800,
+		"minimax":               204800,
+		"minimax-m2.7":          204800,
+		"qwen3-coder":           256000,
+		"dashscope_qwen3_coder": 256000,
+	}
+	for _, id := range ids {
+		key := strings.ToLower(strings.TrimSpace(id))
+		if key == "" {
+			continue
+		}
+		if window, ok := windows[key]; ok {
+			return window
+		}
+	}
+	return fallback
+}
