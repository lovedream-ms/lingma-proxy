+// openAIUsagePayload builds the OpenAI usage object shared by the streaming and
+// non-streaming chat completions endpoints. Real, backend-reported counts win
+// over the local estimate: the Lingma IPC backend reports the true context
+// occupancy (UsedTokens) and the remote backend forwards upstream usage when
+// the upstream sends it. Cache-read and reasoning details are only advertised
+// when they are actually known, so clients never show a fabricated hit rate.
+func openAIUsagePayload(result *service.ChatResult) map[string]any {
+	promptTokens := 0
+	completionTokens := 0
+	cachedTokens := 0
+	reasoningTokens := 0
+	if result != nil {
+		promptTokens = result.InputTokens
+		completionTokens = result.OutputTokens
+		cachedTokens = result.CachedTokens
+		reasoningTokens = result.ReasoningTokens
+		if result.UsedTokens > 0 {
+			promptTokens = result.UsedTokens
+		}
+	}
+	if promptTokens < 0 {
+		promptTokens = 0
+	}
+	if completionTokens < 0 {
+		completionTokens = 0
+	}
+	usage := map[string]any{
+		"prompt_tokens":     promptTokens,
+		"completion_tokens": completionTokens,
+		"total_tokens":      promptTokens + completionTokens,
+	}
+	if cachedTokens > 0 {
+		usage["prompt_tokens_details"] = map[string]any{"cached_tokens": cachedTokens}
+	}
+	if reasoningTokens > 0 {
+		usage["completion_tokens_details"] = map[string]any{"reasoning_tokens": reasoningTokens}
+	}
+	return usage
+}
